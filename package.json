{
  "name": "e-tangguh",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "test": "pnpm -r --filter @etangguh/shared --filter @etangguh/api test",
    "test:integration": "pnpm --filter @etangguh/api test:integration",
    "test:e2e": "pnpm --filter @etangguh/web test:e2e",
    "db:generate": "pnpm --filter @etangguh/api db:generate",
    "db:migrate": "pnpm --filter @etangguh/api db:migrate",
    "db:seed": "pnpm --filter @etangguh/api db:seed",
    "db:seed:spm": "pnpm --filter @etangguh/api db:seed:spm",
    "spm:gen-fixture": "pnpm --filter @etangguh/spm-fixtures spm:gen-fixture"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
